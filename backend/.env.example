# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./portfolio.db
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
# Admin user is created on startup if this is set and no user exists yet
ADMIN_PASSWORD=
CORS_ORIGINS=http://localhost:5173
# Optional: only needed for the AI description feature
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
# Optional: raises the GitHub API rate limit when reading READMEs
GITHUB_TOKEN=
# Login rate limit: failed logins per IP / for all IPs together within the window (seconds)
LOGIN_MAX_FAILURES=5
LOGIN_GLOBAL_MAX_FAILURES=50
LOGIN_WINDOW_SECONDS=900
# 0 locally and in Docker. 1 behind one proxy that appends to X-Forwarded-For (Render)
TRUSTED_PROXIES=0
